# Brewfile — macOS packages
# Install: brew bundle --file=packages/Brewfile
# Update this after installing something: brew bundle dump --force --file=packages/Brewfile

tap "homebrew/cask-fonts"

# ── shell & terminal ──────────────────────────────────────────────────────────
brew "zsh"
brew "bash"
brew "starship"
brew "tmux"

# ── modern CLI replacements ───────────────────────────────────────────────────
brew "eza"          # better ls
brew "bat"          # better cat
brew "ripgrep"      # better grep
brew "fd"           # better find
brew "fzf"          # fuzzy finder
brew "delta"        # better git diff
brew "jq"           # JSON processor
brew "yq"           # YAML processor
brew "zoxide"       # smarter cd
brew "yazi"         # terminal file manager

# ── git ───────────────────────────────────────────────────────────────────────
brew "git"
brew "gh"           # GitHub CLI
brew "lazygit"      # TUI git client
cask "git-credential-manager"  # credential.helper - see secrets/README.md

# ── AI tooling ─────────────────────────────────────────────────────────────────
# Node provides npm, which installs Claude Code, Kilo Code, and GitHub Copilot CLIs.
brew "node"
# Kilo Code CLI and GitHub Copilot CLI (both npm global) are installed by
# install.py alongside Claude Code.
# Install manually on macOS: npm install -g @kilocode/cli
# Install manually on macOS: npm install -g @github/copilot

# ── editor ────────────────────────────────────────────────────────────────────
brew "neovim"

# ── dev tools ─────────────────────────────────────────────────────────────────
brew "curl"
brew "wget"
brew "httpie"       # curl-friendly HTTP client
brew "mkcert"       # local dev certs
brew "direnv"       # per-directory env vars

# ── containers ────────────────────────────────────────────────────────────────
brew "docker"
brew "docker-compose"

# ── fonts ─────────────────────────────────────────────────────────────────────
cask "font-cascadia-code-nf"
cask "font-meslo-lg-nerd-font"

# ── macOS apps ────────────────────────────────────────────────────────────────
cask "visual-studio-code"
cask "iterm2"
cask "raycast"
cask "rectangle"
