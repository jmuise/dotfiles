# ~/.ssh/config — SSH client config
# Copy this to ~/.ssh/config and customize.
# NEVER commit private keys or passwords.

# ── defaults ──────────────────────────────────────────────────────────────────
Host *
    # Reuse connections to the same host
    ControlMaster   auto
    ControlPath     ~/.ssh/sockets/%r@%h:%p
    ControlPersist  10m

    # Keep connections alive
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Always use your default key
    IdentityFile ~/.ssh/id_ed25519

    # Add keys to macOS keychain automatically
    AddKeysToAgent yes
    UseKeychain   yes   # macOS only — remove on Linux

    # Harden ciphers
    Ciphers      chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
    MACs         hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com

# ── jump host pattern ─────────────────────────────────────────────────────────
# Host *.internal
#     ProxyJump   bastion.example.com
#     User        jeremy

# ── example host ─────────────────────────────────────────────────────────────
# Host myserver
#     HostName    192.168.1.100
#     User        jeremy
#     IdentityFile ~/.ssh/id_ed25519_myserver
#     Port        22

# ── GitHub ────────────────────────────────────────────────────────────────────
Host github.com
    HostName    github.com
    User        git
    IdentityFile ~/.ssh/id_ed25519
