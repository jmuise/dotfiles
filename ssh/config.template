# Managed section of ~/.ssh/config — rendered by install.sh, do not edit
# the rendered file directly. Edit this template (repo-tracked) for changes
# that should apply everywhere, or ~/.ssh/config.local (machine-specific,
# never committed) for your own hosts — see ssh/config.local.example.
# NEVER commit private keys or passwords.

# UseKeychain is macOS-only; IgnoreUnknown makes non-macOS OpenSSH (Linux/WSL)
# skip it silently instead of erroring, so this file works unmodified everywhere.
IgnoreUnknown UseKeychain

# ── defaults ──────────────────────────────────────────────────────────────────
Host *
    # Reuse connections to the same host
    ControlMaster   auto
    ControlPath     ~/.ssh/sockets/%r@%h:%p
    ControlPersist  10m

    # Keep connections alive
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Always use your default key
    IdentityFile ~/.ssh/id_ed25519

    # Add keys to macOS keychain automatically
    AddKeysToAgent yes
    UseKeychain   yes

    # Harden ciphers
    Ciphers      chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
    MACs         hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com

# ── GitHub ────────────────────────────────────────────────────────────────────
Host github.com
    HostName    github.com
    User        git
    IdentityFile ~/.ssh/id_ed25519
