{
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-pr-merge.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-ai-attribution.sh\""
          }
        ]
      }
    ]
  }
}
