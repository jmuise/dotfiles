#!/usr/bin/env bash
# Protected-invariant guard for the never-merge boundary that every
# PR-driving/orchestrating agent definition carries, across every CLI copy
# (Claude, Kilo, Copilot, ...).
#
# This USED TO also guard "spine" drift — the requirement that everything
# outside a `<!-- PER-TOOL:BEGIN label --> ... <!-- PER-TOOL:END label -->`
# region stay byte-identical across every guarded file. That mechanism is
# retired: the guarded files are now *generated* from roster/templates/ (see
# roster/render.py), so there is nothing to drift apart — `make roster-check`
# (wired into CI as the `agent-spine-drift` job, same name as before so
# branch protection's required check doesn't need updating) regenerates them
# and diffs against what's committed. `tools/sync-agent.sh`, the marker
# structural-integrity checker, the pinned per-tool label set, and the
# degenerate-spine backstop all went with it — see git history if you need
# the old mechanism's reasoning.
#
# What's left, and still runs on every commit regardless of what it touches:
# the never-merge invariant below. It is independent of the generation
# mechanism on purpose. Even though the roster's templates are now the
# source of truth for these files' *content*, a hand-edit to a generated
# file (bypassing `make roster`) or a bad template edit could still alter a
# never-merge paragraph on its way to being committed, and this check catches
# that at commit time rather than waiting for CI.
#
# Coverage: this used to guard only number-one's three copies. Generation
# means a single template edit now changes every rendered copy of a role at
# once, so the same risk (a bad edit silently weakening a never-merge
# sentence) now applies to every role that carries one, not just number-one.
# Two mechanisms cover that, deliberately kept pure bash (no Python/Jinja2
# dependency, since this runs on every commit regardless of whether the
# roster is touched):
#
#   1. Derived heading scan: every file under claude/agents/, kilo/.kilo/agents/
#      or copilot/agents/ that contains the "## ABSOLUTE RULE — NEVER MERGE"
#      heading, byte-for-byte, must also contain that role's required
#      sentences in that section. This is *derived* (a plain grep across the
#      three roster directories, not a maintained list) specifically so a
#      new agent that adopts the heading can't silently fall outside the
#      check — it starts failing the moment it exists, forcing whoever adds
#      it to also add its required sentences below (see
#      required_heading_sentences_for).
#   2. Pinned regression backstop: a fixed list of files known today to
#      carry a never-merge invariant — either the heading form above, or a
#      never-merge *paragraph* with no dedicated heading (duty-officer's
#      "You never edit code, never write files, never commit, never push,
#      never merge." is inline under "## Scope", not under its own
#      heading). Derivation alone can't catch the heading (or the paragraph)
#      being deleted outright, since a deleted heading/paragraph produces
#      nothing for a grep to find — this list exists specifically to make
#      that a named, loud failure instead of a silent pass.
set -euo pipefail

if ((BASH_VERSINFO[0] < 4)); then
  echo "✖ agent-definition invariant guard requires bash 4.0+ (for associative arrays" >&2
  echo "  keyed by guarded-file path); this shell is bash ${BASH_VERSION:-unknown}." >&2
  echo "  Interpreter in use: $(command -v bash 2>/dev/null || echo 'bash not found on PATH')." >&2
  echo "  This hook is invoked directly by git via its #!/usr/bin/env bash shebang," >&2
  echo "  i.e. whichever \`bash\` PATH resolves first at commit time — not necessarily" >&2
  echo "  a modern one. macOS ships bash 3.2 as /bin/bash and has not updated it in" >&2
  echo "  over a decade (a licensing decision, not an oversight); if that's what this" >&2
  echo "  is, install a newer bash (e.g. \`brew install bash\`) and make sure it comes" >&2
  echo "  before /bin/bash on PATH for the shell git hooks run under." >&2
  exit 1
fi

cd "$(git rev-parse --show-toplevel)"

# One entry per generated file number-one's own three-copy co-presence
# invariant is checked in. Kept as its own list (rather than deriving it
# from roster/targets.py) so this hook has no dependency on Python/Jinja2
# being installed — it is pure bash, and it runs on every commit, not just
# ones that touch the roster.
NUMBER_ONE_GUARDED_FILES=(
  "claude/agents/number-one.md"
  "kilo/.kilo/agents/number-one.md"
  "copilot/agents/number-one.agent.md"
)

# Every directory the roster renders generated agent-definition files into.
# The derived heading scan below walks exactly these, so a new (role, tool)
# target automatically falls under it without this hook needing an update.
ROSTER_DIRS=(
  "claude/agents"
  "kilo/.kilo/agents"
  "copilot/agents"
)

ABSOLUTE_RULE_HEADING='## ABSOLUTE RULE — NEVER MERGE'

# Pinned regression backstop (see header comment, mechanism 2). Format is
# "path:variant", variant one of:
#   heading   — must contain ABSOLUTE_RULE_HEADING; if it does, its sentences
#               are already checked by the derived scan, so this entry only
#               needs to catch the heading having been deleted outright.
#   paragraph — must contain that role's required sentences somewhere in the
#               body; there is no dedicated heading to scope the search to.
#
# This is a *fixed* list (not derived) on purpose: it exists to catch a
# regression in a file already known to carry the invariant, so it must not
# self-update when someone edits the file it's meant to be checking.
PINNED_NEVER_MERGE_FILES=(
  "claude/agents/number-one.md:heading"
  "kilo/.kilo/agents/number-one.md:heading"
  "copilot/agents/number-one.agent.md:heading"
  "claude/agents/implementation-engineer.md:heading"
  "copilot/agents/implementation-engineer.agent.md:heading"
  "claude/agents/duty-officer.md:paragraph"
  "copilot/agents/duty-officer.agent.md:paragraph"
)

# --- required sentences, by role (and, where wording legitimately differs
# per tool, by tool too) --------------------------------------------------
#
# These are load-bearing sentences from each role's never-merge directive
# itself, required byte-for-byte. This repo's standing rules require the
# Captain's explicit per-change confirmation before any of this text is
# touched at all, so a hard-coded duplicate check here turns a silent prose
# edit into an opaque hook failure that names exactly what changed, instead
# of passing silently.
#
# If you are deliberately rewording a never-merge directive with the
# Captain's sign-off, update the matching constants below (and the
# matching roster/templates/*.md.j2) in the same commit as the
# agent-definition edit. If you are adding a new role's never-merge
# heading, add its required sentences here in the same commit — the
# derived scan below will otherwise fail the build the moment the heading
# exists, by design.

NUMBER_ONE_SENTENCES=(
  'You must **never** run `gh pr merge`, `git merge` into a protected branch on someone'\''s behalf to close out a PR, or instruct any worker subagent to do so.'
  'Do not attempt to route around it (no `gh api`, no raw REST calls, no telling a human-looking script to merge for you).'
  'Every PR'\''s terminal state under your management is "pushed, current, CI-green, and awaiting human review" — full stop.'
)

# Common to both implementation-engineer tool variants.
IMPLEMENTATION_ENGINEER_COMMON_SENTENCES=(
  'Never run `gh pr merge`, never `git merge` into a protected branch to close out a PR, never push directly to `main`/`master`, never enable auto-merge, and never use `gh api` or raw REST calls to achieve any of those.'
  'The terminal state of your work is **"pushed, current, CI-green, and awaiting human review"** — full stop. Hand off explicitly and stop there.'
)
# Claude's copy names the enforcing mechanism (a PreToolUse hook); Copilot
# has no equivalent hook to name, so its wording is legitimately different
# here rather than weaker.
IMPLEMENTATION_ENGINEER_CLAUDE_SENTENCE='This is a hard boundary enforced by a `PreToolUse` hook that will block the command and report the attempt; do not attempt to route around it.'
IMPLEMENTATION_ENGINEER_COPILOT_SENTENCE='This is an absolute boundary; do not attempt to route around it.'

# duty-officer has no dedicated "## ABSOLUTE RULE" heading — its never-merge
# text is an inline paragraph under "## Scope" — but the sentences are
# identical across both its tool variants.
DUTY_OFFICER_SENTENCES=(
  'You never edit code, never write files, never commit, never push, never merge.'
  'Never run `gh pr merge`, `git merge` into a protected branch (`main`, `master`, or similarly protected), or any other destructive or state-changing git/gh operation (`git push`, `git reset --hard`, `git clean -f`, `gh pr close`, force operations, etc.). If asked to run one, refuse and report that it'\''s out of scope for a read-only role.'
)

# --- helpers -----------------------------------------------------------

# Read a file's staged (index) content — i.e. what this commit is about to
# record — not whatever happens to be sitting in the working tree.
read_staged() {
  git show ":$1" 2>/dev/null
}

# Strip a *leading* YAML frontmatter block only: the first `---` line at the
# very top of the file, through the next `---` line. Everything after that
# is body, verbatim — including a bare `---` horizontal rule, which is legal
# Markdown and must not be misread as a second frontmatter delimiter.
strip_frontmatter() {
  awk '
    NR==1 && $0=="---" { infm=1; next }
    infm && $0=="---"  { infm=0; next }
    infm                { next }
    { print }
  '
}

# Print the "## ABSOLUTE RULE — NEVER MERGE" section of a body — the heading
# line through (but not including) the next line that starts with "## ", or
# EOF if there is none. Fails (nonzero exit, no output) if the heading isn't
# present at all. Uses exact line equality for the heading match and a plain
# string-prefix test for "the next heading", not regexes, so em dashes,
# asterisks, backticks etc. in surrounding text can never be misread as
# pattern metacharacters.
extract_absolute_rule_section() {
  awk -v heading="$ABSOLUTE_RULE_HEADING" '
    $0 == heading            { found=1; in_section=1; print; next }
    in_section && index($0, "## ") == 1 { in_section=0 }
    in_section                { print }
    END                        { exit(found ? 0 : 1) }
  '
}

# Derive (role, tool) from a roster output path. Role is the basename with
# its tool-specific extension stripped; tool is the top-level directory.
# This mirrors roster/targets.py's own naming convention without depending
# on it (see the ROSTER_DIRS comment above for why this stays derived).
role_for_path() {
  local base
  base=$(basename "$1")
  case "$base" in
    *.agent.md) echo "${base%.agent.md}" ;;
    *.md)       echo "${base%.md}" ;;
    *)          return 1 ;;
  esac
}

tool_for_path() {
  case "$1" in
    claude/*)  echo "claude" ;;
    kilo/*)    echo "kilo" ;;
    copilot/*) echo "copilot" ;;
    *)         return 1 ;;
  esac
}

# Print, one per line, the required sentences for $file's ABSOLUTE RULE
# heading section, given its derived role/tool. Returns nonzero for a role
# this hook doesn't yet know the required sentences for — see the comment
# above the sentence constants for why that is a hard failure rather than a
# silent pass.
required_heading_sentences_for() {
  local file="$1" role tool
  role=$(role_for_path "$file") || return 1
  tool=$(tool_for_path "$file") || return 1
  case "$role" in
    number-one)
      printf '%s\n' "${NUMBER_ONE_SENTENCES[@]}"
      ;;
    implementation-engineer)
      printf '%s\n' "${IMPLEMENTATION_ENGINEER_COMMON_SENTENCES[@]}"
      case "$tool" in
        claude)  printf '%s\n' "$IMPLEMENTATION_ENGINEER_CLAUDE_SENTENCE" ;;
        copilot) printf '%s\n' "$IMPLEMENTATION_ENGINEER_COPILOT_SENTENCE" ;;
        *)
          echo "✖ agent-definition invariant guard: $file carries the ABSOLUTE RULE heading" >&2
          echo "  for role 'implementation-engineer' under an unrecognized tool ('$tool')." >&2
          echo "  Add its required sentence to IMPLEMENTATION_ENGINEER_* in hooks/pre-commit." >&2
          return 1
          ;;
      esac
      ;;
    *)
      echo "✖ agent-definition invariant guard: $file carries the '$ABSOLUTE_RULE_HEADING' heading" >&2
      echo "  for role '$role', which this hook has no required sentences for." >&2
      echo "  Add them to hooks/pre-commit (required_heading_sentences_for) in the same commit" >&2
      echo "  that introduces this role's never-merge heading — do not let it pass unchecked." >&2
      return 1
      ;;
  esac
}

# Assert that every one of $required (newline-separated) appears, byte-for-
# byte, in $haystack. Uses `grep -F` (literal substring match) specifically
# because the required sentences contain backticks, asterisks, double
# quotes and an em dash — none of which should ever be interpreted as
# pattern syntax.
check_required_sentences() {
  local file="$1" haystack="$2" required="$3" what="$4"
  local sentence ok=0

  while IFS= read -r sentence; do
    [ -n "$sentence" ] || continue
    if ! printf '%s\n' "$haystack" | grep -qF -- "$sentence"; then
      echo "✖ agent-definition invariant guard: $file's $what is missing or has altered" >&2
      echo "  this required sentence (byte-for-byte match failed):" >&2
      echo "    $sentence" >&2
      echo "  The never-merge boundary is a protected invariant which cannot be changed by" >&2
      echo "  editing the agent definition alone — see hooks/pre-commit." >&2
      ok=1
    fi
  done <<<"$required"
  return "$ok"
}

# --- 1. number-one's own three-copy co-presence invariant ---------------

declare -A number_one_body_of
missing=0
for f in "${NUMBER_ONE_GUARDED_FILES[@]}"; do
  if ! content=$(read_staged "$f"); then
    echo "✖ agent-definition invariant guard: $f is missing from the index (deleted or never added)." >&2
    echo "  All of: ${NUMBER_ONE_GUARDED_FILES[*]} must exist together." >&2
    echo "  If retiring one of them is intentional, update NUMBER_ONE_GUARDED_FILES in hooks/pre-commit too." >&2
    missing=1
    continue
  fi
  number_one_body_of["$f"]=$(printf '%s\n' "$content" | strip_frontmatter)
done
if [ "$missing" -eq 1 ]; then
  exit 1
fi

invariant_fail=0

# --- 2. derived heading scan ---------------------------------------------
# Every file under ROSTER_DIRS whose staged content contains the ABSOLUTE
# RULE heading must pass its role's required-sentence check. Derived from
# the tracked file list, not a maintained list, so a new agent that adopts
# the heading can't silently fall outside this check (see header comment).
while IFS= read -r f; do
  [ -n "$f" ] || continue
  content=$(read_staged "$f") || continue
  body=$(printf '%s\n' "$content" | strip_frontmatter)
  if ! printf '%s\n' "$body" | grep -qF -- "$ABSOLUTE_RULE_HEADING"; then
    continue
  fi

  if [ -n "${number_one_body_of[$f]+set}" ]; then
    body="${number_one_body_of[$f]}"
  fi

  section=$(printf '%s\n' "$body" | extract_absolute_rule_section) || {
    # Contains the heading text somewhere (e.g. in prose) but not as its own
    # line — extraction failing here despite the earlier grep hit means the
    # heading isn't a real section marker. Treat as absent/altered.
    echo "✖ agent-definition invariant guard: $f contains '$ABSOLUTE_RULE_HEADING' text but not" >&2
    echo "  as its own heading line; the ABSOLUTE RULE section could not be extracted." >&2
    invariant_fail=1
    continue
  }

  required=$(required_heading_sentences_for "$f") || { invariant_fail=1; continue; }
  if ! check_required_sentences "$f" "$section" "$required" "ABSOLUTE RULE section"; then
    invariant_fail=1
  fi
done < <(git ls-files -- "${ROSTER_DIRS[@]}")

# --- 3. pinned regression backstop ---------------------------------------
# Independent of whether the derived scan above found anything for $f: this
# is what catches the heading (or, for the paragraph variant, the required
# sentences) having been deleted outright, which produces nothing for a
# grep-for-the-heading scan to find.
for entry in "${PINNED_NEVER_MERGE_FILES[@]}"; do
  f="${entry%%:*}"
  variant="${entry#*:}"

  if [ -n "${number_one_body_of[$f]+set}" ]; then
    body="${number_one_body_of[$f]}"
  else
    content=$(read_staged "$f") || {
      echo "✖ agent-definition invariant guard: $f is missing from the index (deleted or never added)," >&2
      echo "  but is pinned in PINNED_NEVER_MERGE_FILES as a file that must carry a never-merge" >&2
      echo "  invariant. If retiring it is intentional, update PINNED_NEVER_MERGE_FILES too." >&2
      invariant_fail=1
      continue
    }
    body=$(printf '%s\n' "$content" | strip_frontmatter)
  fi

  case "$variant" in
    heading)
      if ! printf '%s\n' "$body" | grep -qF -- "$ABSOLUTE_RULE_HEADING"; then
        echo "✖ agent-definition invariant guard: $f previously carried the" >&2
        echo "  '$ABSOLUTE_RULE_HEADING' heading and no longer does." >&2
        echo "  The never-merge boundary is a protected invariant: it cannot be removed by" >&2
        echo "  editing the agent definition alone." >&2
        invariant_fail=1
      fi
      ;;
    paragraph)
      if ! check_required_sentences "$f" "$body" "$(printf '%s\n' "${DUTY_OFFICER_SENTENCES[@]}")" "body"; then
        invariant_fail=1
      fi
      ;;
    *)
      echo "✖ agent-definition invariant guard: PINNED_NEVER_MERGE_FILES entry '$entry' has an" >&2
      echo "  unrecognized variant ('$variant'); expected 'heading' or 'paragraph'." >&2
      invariant_fail=1
      ;;
  esac
done

if [ "$invariant_fail" -eq 1 ]; then
  exit 1
fi

exit 0
