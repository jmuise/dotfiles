[core]
	excludesfile = ~/.gitignore_global
	editor       = code --wait
	autocrlf     = input
	pager        = delta

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default         = current

[rebase]
	autoStash = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm     = histogram
	colorMoved    = default

[delta]
	navigate    = true
	line-numbers = true
	side-by-side = false
	dark        = true

[fetch]
	prune     = true
	pruneTags = true

[tag]
	sort = version:refname

[log]
	date = iso

# Synthetic host used to store tool tokens (e.g. Claude Code) as generic
# git credentials via whatever credential.helper is active - see
# secrets/README.md. "provider = generic" skips GCM's remote-host
# auto-detection probe, which otherwise adds a multi-second delay/warning
# any time a credential.helper is configured but this host has no secret
# stored under it yet (e.g. before secrets/setup-claude-token.sh has run).
[credential "https://dotfiles-secrets.local"]
	provider = generic

# Carries the real git identity (name in username, email in password) into
# devcontainers via the same forwarding channel as the synthetic host above -
# install.sh pushes it here from the host/WSL, and pulls it back inside a
# devcontainer, instead of depending on VS Code's own "copy git config"
# feature, which doesn't reliably fire (see
# memory/project_dotfiles_identity_guard.md). "provider = generic" for the
# same reason as above: skips GCM's slow auto-detection probe.
[credential "https://dotfiles-identity.local"]
	provider = generic

# Carries `gh`'s own auth token into devcontainers via the same forwarding
# channel - a devcontainer has no persisted `gh auth login` session of its
# own (secrets/README.md's "already handled by OS keyring" claim only holds
# on a machine gh was actually logged into), so install.sh pushes it here
# from the host/WSL and pulls it back inside a devcontainer, same pattern as
# dotfiles-identity.local above. "provider = generic" for the same reason.
[credential "https://dotfiles-gh.local"]
	provider = generic

[alias]
	# status / log
	s    = status -sb
	l    = log --oneline --graph --decorate -20
	la   = log --oneline --graph --decorate --all -30
	last = log -1 HEAD --stat

	# branching
	co   = checkout
	cob  = checkout -b
	br   = branch -vv
	brd  = branch -d
	brD  = branch -D

	# committing
	a    = add
	aa   = add --all
	c    = commit -m
	ca   = commit --amend --no-edit
	can  = commit --amend

	# stash
	ss   = stash push -m
	sl   = stash list
	sp   = stash pop

	# utility
	undo = reset HEAD~1 --mixed
	unstage = reset HEAD --
	cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -r git branch -d"
	whoami  = "!git config user.name && git config user.email"
