# Machine-local overrides — never commit these
*.local
.gitconfig.local

# SSH — only config.template and config.local.example are tracked
ssh/config
ssh/config.local
ssh/sockets/

# macOS
.DS_Store

# Kilo project-level config (created at runtime by the CLI — separate from the
# tracked kilo/ directory, which holds global config symlinked to ~/.config/kilo/)
/.kilo/

# Editor
.vscode/
*.swp
